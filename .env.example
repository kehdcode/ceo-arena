# Postgres connection string (Neon: use the "pooled" connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Any long random string; Vercel uses it to authorise the daily auto-lock cron
CRON_SECRET=replace-with-a-long-random-string
# Set to "true" only while you want every visitor to see the admin panel
ARENA_ADMIN_MODE=false
